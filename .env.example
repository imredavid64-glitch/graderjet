# Optional. When unset, GraderJet runs a deterministic mock grading agent
# (no network calls) so the app works out of the box.
# When set, the chat route uses a real OpenAI model for agentic grading.
OPENAI_API_KEY=

# OpenRouter (alternative to OPENAI_API_KEY; supports many models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
